{
  "name": "runtime-doctor",
  "version": "1.0",
  "status": "partially_implemented",
  "trigger": "user request, not background daemon",
  "default_permissions": [
    "read-only",
    "no cloud",
    "no installs"
  ],
  "steps": [
    {
      "index": 1,
      "instruction": "Require explicit runtime kind",
      "evidence_required": true
    },
    {
      "index": 2,
      "instruction": "Validate loopback address and timeout",
      "evidence_required": true
    },
    {
      "index": 3,
      "instruction": "Fetch only listed health/model endpoints",
      "evidence_required": true
    },
    {
      "index": 4,
      "instruction": "Record status and untested inference/privacy",
      "evidence_required": true
    }
  ],
  "human_approval": "Any external/network writes, install, model download, elevated access, hosted operation",
  "outcome_statuses": [
    "observed",
    "heuristic",
    "not_run",
    "unknown",
    "blocked"
  ]
}
