{
  "name": "model-fit",
  "version": "1.0",
  "status": "partially_implemented",
  "trigger": "user request, not background daemon",
  "default_permissions": [
    "read-only",
    "no cloud",
    "no installs"
  ],
  "steps": [
    {
      "index": 1,
      "instruction": "Load bounded user-supplied model catalog",
      "evidence_required": true
    },
    {
      "index": 2,
      "instruction": "Apply documented parameter/quantization RAM heuristic",
      "evidence_required": true
    },
    {
      "index": 3,
      "instruction": "Check free RAM and headroom",
      "evidence_required": true
    },
    {
      "index": 4,
      "instruction": "Report uncertainty and no performance promises",
      "evidence_required": true
    }
  ],
  "human_approval": "Any external/network writes, install, model download, elevated access, hosted operation",
  "outcome_statuses": [
    "observed",
    "heuristic",
    "not_run",
    "unknown",
    "blocked"
  ]
}
